# Copy to .env for local development (never commit .env).
# In production, set these in Netlify: Site configuration → Environment variables.

# Your Scrape Creators API key (https://app.scrapecreators.com). Server-side only.
SCRAPE_CREATORS_API_KEY=

# Shared password users enter to use the app (protects your API credits).
APP_ACCESS_PASSWORD=

# Optional: max API requests per IP per hour (search, trending, profile-niche, transcript). Default 30.
RATE_LIMIT_PER_HOUR=
