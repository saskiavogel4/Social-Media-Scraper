# Copy to .env for local development (never commit .env).
# In production, set these in Netlify: Site configuration → Environment variables.

# Your Scrape Creators API key (https://app.scrapecreators.com). Server-side only.
SCRAPE_CREATORS_API_KEY=

# Optional: point sign-in at a different Supabase project than the default in
# shared/supabaseConfig.ts. The VITE_ pair is read by the browser at build time,
# the other pair by the Netlify Functions. Publishable keys only — never the secret key.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Optional: max API requests per account per hour (search, trending, profile-niche, transcript). Default 30.
RATE_LIMIT_PER_HOUR=

# Optional: max uncached Scrape Creators calls (≈ credits) per account per hour. Default 60.
CALL_LIMIT_PER_HOUR=
